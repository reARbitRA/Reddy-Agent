# ============================================================
# REDDY Agent — environment template
# Every variable below is read by the repository code.
# Copy to .env (loaded by dotenv in server.ts) and fill in.
# ============================================================

# GEMINI_API_KEY — required for AI features.
# Read by core/orchestrator.ts (provider init) and server.ts (/api/keys/status).
# Can also be supplied at runtime through the KeyDeck panel
# (POST /api/keys/save), which takes precedence over this variable.
GEMINI_API_KEY=""

# GEMINI_MODEL — optional. Provider model identifier.
# Read by core/orchestrator.ts (resolveModel). Defaults to gemini-3.8-flash.
# A model Google has shut down (gemini-1.0-*, gemini-1.5-*, gemini-2.0-flash)
# is rejected at resolution time with MODEL_RETIRED rather than 404ing later.
# GEMINI_MODEL="gemini-3.8-flash"

# REDDY_API_TOKEN — REQUIRED for any deployment reachable beyond localhost.
# Read by server.ts (requireApiAuth). When set, every /api route requires
# "Authorization: Bearer <token>" (or "x-reddy-token: <token>") and answers 401
# otherwise. When unset the server boots in INSECURE_ANONYMOUS_MODE and logs a
# warning — that mode is for local development only.
# REDDY_API_TOKEN=""

# ALLOWED_DEV_HOSTS — optional. Comma-separated Host headers the Vite dev
# server accepts. Read by vite.config.ts. Defaults to localhost,127.0.0.1.
# ALLOWED_DEV_HOSTS="localhost,127.0.0.1"

# PORT — optional. TCP port for the Express server.
# Read by server.ts. Defaults to 3000 when unset.
# PORT=3000

# NODE_ENV — optional. Set to "production" when running the built server
# ("npm run build && npm start") so Express serves dist/ as static files
# instead of mounting the Vite dev middleware. Read by server.ts.
# NODE_ENV="production"

# DISABLE_HMR — optional. Set to "true" to disable Vite HMR and file
# watching during development. Read by vite.config.ts.
# DISABLE_HMR="false"
